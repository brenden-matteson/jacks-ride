<%- include("partials/header.ejs") %>

<div class="body-containter">
    <div class="body-object">
        <h1>Home</h1>
    </div>
</div>

<% if (locals.rides) { %>
    <div class="ride-container">
        <% rides.forEach(ride => { %>
            <div class="ride-container">
                <a href="<%= __dirname %><%= ride.ride_id %>/ride"></a>
                
            </div>
        <% }); %>
    </div>
<% } %>

