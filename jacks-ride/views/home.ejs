<%- include("partials/header.ejs", { pageStylesheet: 'home' }) %>

<% if (locals.filtered_rides) { %>
    <div class="ride-container">
        <% filtered_rides.forEach(ride => { %>
            <div class="ride-object">
                <a href="<%= __dirname %><%= ride.ride_id %>/ride">
                    <h3><%= ride.creator_name %></h3>
                    <div><%= ride.date_created %> - <%= ride.ride_type %></div>
                    <h3><%= ride.title %></h3>
                    <p><%= ride.body %></p>
                    <div class="tag-container">
                        <span class="ride-tag"><%= ride.ride_date %></span>
                        <% if (ride.payment_amount) { %>
                        <span class="ride-tag">$<%= ride.payment_amount %> Requested</span>
                        <% } %>
                        <span class="ride-tag"><%= ride.one_way_two_way %></span>
                        <span class="ride-tag"><%= ride.destination %></span>
                        <span class="ride-tag"><%= ride.pets %></span>
                        <% if (ride.seats_available) { %>
                        <span class="ride-tag">Seats: <%= ride.seats_available %></span>
                        <% } %>
                    </div>
                </a>
            </div>
        <% }); %>
    </div>
<% } %>

<%- include("partials/navigation.ejs") %>