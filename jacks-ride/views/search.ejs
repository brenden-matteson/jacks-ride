<%- include("partials/header.ejs") %>

<main class="search-page">

    <!-- Search Section -->
    <section class="search-section">

        <form class="search-form" id="searchForm">

            <div class="search-bar">
                <input
                    type="text"
                    id="searchInput"
                    name="query"
                    placeholder="Search for rides or destinations"
                >

                <button type="submit" class="search-button">
                    <img src="/images/icons/search.png" alt="Search">
                </button>
            </div>

            <button type="button"
                    class="filter-button"
                    id="filterButton">
                <img src="/images/icons/filter.png" alt="Filters">
            </button>

            <!-- Filter Dropdown -->
            <div class="filter-dropdown" id="filterDropdown">

                <h3>Filter Rides</h3>

                <div class="filter-group">
                    <label for="date">Date</label>
                    <input type="date" id="date" name="date">
                </div>

                <div class="filter-group">
                    <label for="time">Time</label>
                    <input type="time" id="time" name="time">
                </div>

                <div class="filter-group">
                    <label for="location">Location</label>
                    <input
                        type="text"
                        id="location"
                        name="location"
                        placeholder="Starting location"
                    >
                </div>

                <div class="filter-group">
                    <label for="destination">Destination</label>
                    <input
                        type="text"
                        id="destination"
                        name="destination"
                        placeholder="Where are you going?"
                    >
                </div>

                <div class="filter-group">
                    <label for="seats">Available Seats</label>
                    <input
                        type="number"
                        id="seats"
                        name="seats"
                        min="1"
                        placeholder="Number of seats"
                    >
                </div>

                <div class="filter-group">
                    <label for="cost">Maximum Cost ($)</label>
                    <input
                        type="number"
                        id="cost"
                        name="cost"
                        min="0"
                        step="0.01"
                        placeholder="Maximum cost"
                    >
                </div>

                <button type="submit" class="apply-filters">
                    Apply Filters
                </button>

            </div>

        </form>

    </section>

    <!-- Results Section -->
    <section class="results-section">

        <h2>Search Results</h2>

        <div class="no-results" id="resultsMessage">
            <p>Search for a ride to see results</p>
        </div>

    </section>

</main>

<%- include("partials/navigation.ejs") %>

<script>
    const searchForm = document.getElementById('searchForm');
    const searchInput = document.getElementById('searchInput');
    const resultsMessage = document.getElementById('resultsMessage');

    searchForm.addEventListener('submit', function(event) {
        event.preventDefault();

        const searchValue = searchInput.value.trim();

        if (searchValue === '') {
            resultsMessage.innerHTML = `
                <p>Please enter a ride or destination to search</p>
            `;
            return;
        }

        resultsMessage.innerHTML = `
            <p>No rides found matching your search</p>
        `;
    });

    // Filter dropdown
    const filterButton = document.getElementById('filterButton');
    const filterDropdown = document.getElementById('filterDropdown');

    filterButton.addEventListener('click', function() {
        filterDropdown.classList.toggle('active');
    });

    document.addEventListener('click', function(event) {
        if (
            !filterDropdown.contains(event.target) &&
            !filterButton.contains(event.target)
        ) {
            filterDropdown.classList.remove('active');
        }
    });
</script>

