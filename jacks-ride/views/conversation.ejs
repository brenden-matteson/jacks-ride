<%- include("partials/header.ejs", { pageStylesheet: 'conversation' }) %>
<div class="conversation-body">
    <div class="user-header">
        <a href="<%= __dirname %>notifications">
            <div class="back-arrow">
                <span>&lsaquo;</span>
            </div>
        </a>
        <div class="user-header-object">
            <% if (user.creator_id == conversation.user1_id) { %>
                <h1><%= conversation.user2_name %></h1>
                <h3><%= conversation.user2_role %></h3>
            <% } else { %>
                <h1><%= conversation.user1_name %></h1>
                <h3><%= conversation.user1_role %></h3>
            <% } %>
        </div>
        <a href="<%= __dirname %><%= user.creator_id == conversation.user1_id ? conversation.user2_id : conversation.user1_id %>/report" class="user-header-object">
            <div class="notification-icon">
                <span>!</span>
            </div>
        </a>
    </div>

    <% if (locals.messages) { %>
    <div class="conversation-container">
        <% messages.forEach(message => { %>
            <div class="message <%= message.sender_id == user.creator_id ? "sent" : "received" %>">
                <%= message.message_text %>
            </div>
            <small><%= message.sent_at %></small>
        <% }); %>
    </div>
    <% } %>

    <form class="message-input">
        <input type="text" placeholder="Text Message" aria-label="Message" />
        <button type="submit" aria-label="Send message">
            <span>🠉</span>
        </button>
    </form>
</div>

<%- include("partials/navigation.ejs") %>
