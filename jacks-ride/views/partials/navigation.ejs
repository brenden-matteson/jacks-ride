<footer>
    <div class="nav-container">
        <div class="nav-object">
            <form id="home" action="/home" method="get">
                <button type="submit">
                    <img src="<%= __path=="/home" ? "/images/icons/home-inverse.png" : "/images/icons/home.png" %>" alt="Home Icon">
                </button>
            </form>
        </div>
        <div class="nav-object">
            <form id="home" action="/search" method="get">
                <button type="submit">
                    <img src="<%= __path=="/search" ? "/images/icons/search.png" : "/images/icons/search.png" %>" alt="Search Icon">
                </button>
            </form>
        </div>
        <div class="nav-object">
            <form id="home" action="/add-post" method="get">
                <button type="submit">
                    <img src="<%= __path=="/add-post" ? "/images/icons/square-plus-inverse.png" : "/images/icons/square-plus.png" %>" alt="Add Icon">
                </button>
            </form>  
        </div>
        <div class="nav-object">
            <form id="home" action="<%= __dirname %>notifications" method="get">
                <button type="submit">
                    <img src="<%= __path=="/notifications" || __path=="/:id/conversation" ? "/images/icons/chat-notification-inverse.png" : "/images/icons/chat-notification.png" %>" alt="Notification Icon">
                </button>
            </form>
        </div>
        <div class="nav-object">
            <form id="home" action="<%= __dirname %><%= user.creator_id %>/settings" method="get">
                <button type="submit">
                    <img src="<%= __path=="/:id/settings" ? "/images/icons/user-inverse.png" : "/images/icons/user.png" %>" alt="Settings Icon">
                </button>
            </form>
        </div>
    </div>
</footer>
</html>