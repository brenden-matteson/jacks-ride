<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/home.css">
    <link rel="stylesheet" href="/styles/header.css">
    <link rel="stylesheet" href="/styles/navigation.css">
    <title>JacksRide</title>
</head>
<header>
    <% if (locals.__pagename) { %>
        <div class="header-container">
            <div class="header-object">
                <div><%= __pagename %></div>
            </div>
        </div>
        <% if (locals.__path=="/home") { %>
            <div class="header-container">
                <div class="header-object" style="border-bottom: <%= filter_tab=="all" ? "3px solid navy" : "none" %>">
                    <a href="<%= __dirname %>home?all"><div>All Rides</div></a>
                </div>
                <div class="header-object" style="border-bottom: <%= filter_tab=="requests" ? "3px solid navy" : "none" %>">
                    <a href="<%= __dirname %>home?requests"><div>Ride Requests</div></a>
                </div>
                <div class="header-object" style="border-bottom: <%= filter_tab=="offers" ? "3px solid navy" : "none" %>">
                    <a href="<%= __dirname %>home?offers"><div>Ride Offers</div></a>
                </div>
            </div>
        <% } %>
    <% } %>
</header>
<body>